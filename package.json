{
  "name": "dsh-auto-answer",
  "version": "0.1.0",
  "private": true,
  "description": "DSH plugin: answer ask_user_question prompts with an LLM. Option-only questions, fail-closed to the human UI.",
  "license": "MIT",
  "author": "Samuel-Ku",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "ask-user-question",
    "auto-answer",
    "llm",
    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Samuel-Ku/dsh-auto-answer.git"
  },
  "homepage": "https://github.com/Samuel-Ku/dsh-auto-answer",
  "bugs": {
    "url": "https://github.com/Samuel-Ku/dsh-auto-answer/issues"
  },
  "scripts": {
    "test": "node --test test/logic.test.mjs test/probe.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-timeout": "^0.1.5-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-timeout": "^0.1.7-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.5-rc.1": "compatible",
        "0.1.5-rc.2": "compatible"
      },
      "node": ">=20"
    }
  }
}
